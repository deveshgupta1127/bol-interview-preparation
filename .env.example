# Copy to .env and fill in. Never commit .env.

# Claude (reasoning: questions, rubric scoring, rewrites, feedback). Called only from the backend.
# Leave empty to run with built-in stand-in answers (no cost) while developing.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Gnani speech APIs (Prisma speech-to-text, Timbre text-to-speech and voice cloning). One key for all.
# Leave empty to run with a sample transcript and no audio while developing.
VACHANA_API_KEY=
# Speech-to-text model: Prisma v3.0 auto-detects Hindi inside English answers; codemix keeps English in Latin script.
STT_MODEL=prisma-v3.0
STT_LANGUAGE=indic-auto
STT_FORMAT=codemix

# ---------- Azure only (leave empty locally) ----------
# Bol stores nothing on the server: no database, no file storage, no sign-in. The browser keeps each student's
# practice in its own storage.
# CORS_ORIGINS=https://<your-site>.azurestaticapps.net
# SERVE_WEB=false         (the Docker image sets this; Static Web Apps serves web/)
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# SIGNING_SECRET=         (optional; signs the texts Bol may read aloud. Derived from the API keys if empty)

# Spend guards, kept in memory (reset when the server restarts; 0 = no limit). The hard caps are the Claude
# workspace spend limit and your Gnani credits.
# LIMIT_HEAVY_PER_MINUTE=20            (per address: new sessions, answers, speech, voice set-ups)
# LIMIT_REQUESTS_PER_MINUTE_PER_IP=120
# Proxies in front of the API that add to X-Forwarded-For. Defaults to 1 on Container Apps, 0 elsewhere.
# TRUSTED_PROXY_HOPS=1
# BUDGET_CLAUDE_USD_PER_MONTH=25
# BUDGET_PRISMA_MINUTES_PER_MONTH=0
# BUDGET_TIMBRE_CHARS_PER_MONTH=0
