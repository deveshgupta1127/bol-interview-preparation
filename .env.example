# Copy to .env and fill in. Never commit .env.

# Claude (reasoning: questions, rubric scoring, rewrites, feedback). Called only from the backend.
# Leave empty to run with built-in stand-in answers (no cost) while developing.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# Gnani speech APIs (Prisma speech-to-text, Timbre text-to-speech and voice cloning). One key for all.
# Leave empty to run with a sample transcript and no audio while developing.
VACHANA_API_KEY=
# Speech-to-text model: Prisma v3.0 auto-detects Hindi inside English answers; codemix keeps English in Latin script.
STT_MODEL=prisma-v3.0
STT_LANGUAGE=indic-auto
STT_FORMAT=codemix

# Database. Empty = bol.db next to the app. On Azure: Azure Database for PostgreSQL, e.g.
#   postgresql://bol_app:<password>@bol-pg.postgres.database.azure.com:5432/bol?sslmode=require
# The schema is created and upgraded automatically at start-up (Alembic, migrations/).
# DATABASE_URL=

# ---------- Azure only (leave empty locally) ----------
# Sign-in with Entra External ID. Empty AUTH_ISSUER = local mode with one built-in student.
# The API refuses to start on Azure Container Apps without it.
# AUTH_ISSUER=https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
# AUTH_AUDIENCE=<API app registration's client id>
# AUTH_JWKS_URL=          (optional; found from the issuer if empty)
# AUTH_SCOPE=practice.readwrite
# CORS_ORIGINS=https://<your-site>.azurestaticapps.net
# SERVE_WEB=false         (the Docker image sets this; Static Web Apps serves web/)
# TTS_CACHE_URL=https://bolstore.blob.core.windows.net   (managed identity, container tts-cache)
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Spend guards (starting values; 0 = no limit)
# LIMIT_ANSWERS_PER_DAY=30
# LIMIT_SESSIONS_PER_DAY=5
# LIMIT_AUDIO_PLAYS_PER_DAY=40
# LIMIT_VOICE_CLONES_PER_DAY=3
# Per minute (burst) limits, per replica. Expensive calls per student; all API calls per address.
# LIMIT_HEAVY_PER_MINUTE=10
# LIMIT_REQUESTS_PER_MINUTE_PER_IP=120
# Proxies in front of the API that add to X-Forwarded-For. Defaults to 1 on Container Apps, 0 elsewhere.
# TRUSTED_PROXY_HOPS=1
# BUDGET_CLAUDE_USD_PER_MONTH=25
# BUDGET_PRISMA_MINUTES_PER_MONTH=0
# BUDGET_TIMBRE_CHARS_PER_MONTH=0
